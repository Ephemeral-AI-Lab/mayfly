|    • third point, with a nested list:
|        • nested one
|        • nested two
|
|    ```ts
|      export function section5(input: readonly string[],
|    width: number): string[] {
|        const rows: string[] = []
|        for (const line of input) {
|          if (line.length === 0) { rows.push(''); continue }
|          for (let at = 0; at < line.length; at += width)
|    rows.push(line.slice(at, at + width))
|        }
|        return rows.map(row => row.padEnd(width, ' '))
|      }
|    ```
