{
  "name": "@mayfly-example/ecosystem",
  "description": "Opt-in composition bundle for all Mayfly ecosystem examples",
  "version": "0.1.0",
  "private": true,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json" },
  "files": ["lib/**/*", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@mayfly-example/user-kit": "workspace:*",
    "@mayfly-example/header": "workspace:*",
    "@mayfly-example/right-inspector": "workspace:*",
    "@mayfly-example/bottom-log": "workspace:*",
    "@mayfly-example/overlay": "workspace:*",
    "@mayfly-example/ui-gallery": "workspace:*"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.2", "@ephemeral-ai/mayfly": "workspace:*" },
  "devDependencies": { "@deepseek-ai/cordis": "4.0.2", "@ephemeral-ai/mayfly": "workspace:*" }
}
