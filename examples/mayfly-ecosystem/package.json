{
  "name": "@mayfly-example/ecosystem",
  "description": "Opt-in TUI source composition of all Mayfly ecosystem examples",
  "version": "0.1.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mayfly-ecosystem": "lib/bin.js"
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "dependencies": {
    "@mayfly-example/header": "workspace:*",
    "@mayfly-example/right-inspector": "workspace:*",
    "@mayfly-example/bottom-log": "workspace:*",
    "@mayfly-example/overlay": "workspace:*",
    "@mayfly-example/ui-gallery": "workspace:*",
    "@ephemeral-ai/mayfly": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0"
  }
}
