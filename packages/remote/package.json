{
  "name": "@ephemeral-ai/mayfly-remote",
  "description": "Independent HTTP/WebSocket Mayfly frontend for one or more dsh Hosts",
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./remote-bin": {
      "types": "./lib/types/remote-bin.d.ts",
      "default": "./lib/remote-bin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "homepage": "https://may-fly.dev",
  "bugs": {
    "url": "https://github.com/Ephemeral-AI-Lab/mayfly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/mayfly.git",
    "directory": "packages/remote"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.11-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-job-controller": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-brand": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-goal": "0.2.2-alpha.3",
