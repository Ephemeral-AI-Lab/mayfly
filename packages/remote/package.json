{
  "name": "@ephemeral-ai/mayfly-remote",
  "description": "Independent HTTP/WebSocket Mayfly frontend for one or more dsh Hosts",
  "version": "0.1.4-rc.2",
  "publishConfig": { "access": "public" },
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/client.js" },
    "./remote-bin": { "types": "./lib/types/remote-bin.d.ts", "default": "./lib/remote-bin.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "homepage": "https://may-fly.dev",
  "bugs": { "url": "https://github.com/Ephemeral-AI-Lab/mayfly/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/Ephemeral-AI-Lab/mayfly.git", "directory": "packages/remote" },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-job-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-goal": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-schedule": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@ephemeral-ai/mayfly": "0.1.4-rc.2",
    "@ephemeral-ai/mayfly-host": "0.1.4-rc.2",
    "@ephemeral-ai/mayfly-ui": "0.1.4-rc.2",
    "immer": "^10.1.1",
    "ws": "^8.21.3",
    "zustand": "~4.5.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-account-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-market": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@types/node": "^24.9.0",
    "@types/ws": "8.18.1",
    "vitest": "^4.1.8"
  }
}
