    "@deepseek-ai/dsh-schedule": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-query": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session-stats": "0.2.2-alpha.3",
