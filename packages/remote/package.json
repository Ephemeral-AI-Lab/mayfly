    "@deepseek-ai/dsh-workflow": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.6-alpha.2",
    "@ephemeral-ai/mayfly": "0.1.5",
    "@ephemeral-ai/mayfly-host": "0.1.5",
    "@ephemeral-ai/mayfly-ui": "0.1.5",
    "immer": "^10.1.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "~4.5.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-alpha.3",
