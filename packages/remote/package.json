    "@deepseek-ai/dsh-plugin-manager": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-plugin-market": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "@types/node": "^24.9.0",
    "@types/ws": "8.18.1",
    "vitest": "^4.1.8"
  }
