{
  "name": "@ephemeral-ai/mayfly",
  "description": "Mayfly terminal UI: the independent HTTP/WebSocket frontend for one or more DeepSeek Harness Hosts",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mayfly",
    "tui",
    "terminal-ui",
    "cordis",
    "pi-tui",
    "coding-agent"
  ],
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./bin": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "THIRD-PARTY-NOTICES.md"
  ],
  "license": "MIT",
  "homepage": "https://may-fly.dev",
  "bugs": {
    "url": "https://github.com/Ephemeral-AI-Lab/mayfly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/mayfly.git",
    "directory": "packages/mayfly"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-account-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-job-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-goal": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-market": "0.2.2-rc.1",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-stats": "0.2.2-rc.1",
