    "@deepseek-ai/schemastery": "3.19.0",
    "@earendil-works/pi-tui": "^0.84.2",
    "@ephemeral-ai/mayfly-host": "workspace:*",
    "@ephemeral-ai/mayfly-ui": "workspace:*",
    "beautiful-mermaid": "1.1.3",
    "cli-highlight": "^2.1.11",
    "cross-spawn": "7.0.6",
    "diff": "9.0.0",
    "marked": "18.0.5",
    "semver": "7.8.5",
