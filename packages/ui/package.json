{
  "name": "@ephemeral-ai/mayfly-ui",
  "description": "Renderer-neutral contracts, builders, and UI contribution services for Mayfly",
  "version": "0.1.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
