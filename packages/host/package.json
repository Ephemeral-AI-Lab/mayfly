{
  "name": "@ephemeral-ai/mayfly-host",
  "description": "Mayfly Host projections, Remote capabilities, and profile composition for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mayfly",
    "host",
    "cordis"
  ],
  "version": "0.1.4-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "homepage": "https://may-fly.dev",
  "bugs": {
    "url": "https://github.com/Ephemeral-AI-Lab/mayfly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/mayfly.git",
    "directory": "packages/host"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-web-app": "0.2.2-alpha.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-goal": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-goal": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-alpha.2"
  }
}
